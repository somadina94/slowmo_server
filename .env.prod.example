# =============================================================================
# Slow Mo API — production env (keep on the server as `.env`, never commit)
# =============================================================================
#
# Neon Postgres: paste the full connection string into DATABASE_URL.
# Example (psycopg v3 driver used by SQLAlchemy):
#   DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
#
# Neon is Postgres only — object storage is Backblaze B2 (STORAGE_BACKEND=b2).
#
# GHCR (optional for CI — push uses GITHUB_TOKEN. For manual server pulls):
#   GHCR_USERNAME=your-github-username
#   GHCR_TOKEN=ghp_xxx   # PAT with read:packages
# =============================================================================

APP_ENV=prod
APP_DEBUG=false
APP_SECRET_KEY=replace-with-long-random-secret

# Single Neon connection string (includes password)
DATABASE_URL=postgresql+psycopg://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

CORS_ORIGINS=https://slowmo.co,https://www.slowmo.co,http://localhost:5011,http://127.0.0.1:5011
TRUSTED_HOSTS=slowmo.co,www.slowmo.co,api.slowmo.co,localhost,127.0.0.1
JWT_ACCESS_SECRET=replace-with-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7

RAZORPAY_KEY_ID=rzp_live_replace
RAZORPAY_KEY_SECRET=replace
RAZORPAY_WEBHOOK_SECRET=replace
RAZORPAY_WEBHOOK_URL=https://api.slowmo.co/api/v1/webhooks/razorpay

SHIPPING_PROVIDER=stub

# Backblaze B2 (S3-compatible API)
STORAGE_BACKEND=b2
STORAGE_DIR=/app/storage/rx
B2_ENDPOINT=s3.us-east-005.backblazeb2.com
B2_BUCKET_ID=replace-with-bucket-id
B2_BUCKET_NAME=replace-with-bucket-name
B2_APPLICATION_KEY_ID=replace-with-key-id
B2_APPLICATION_KEY=replace-with-application-key
B2_BUCKET_REGION=us-east-005
B2_PUBLIC_FILE_BASE_URL=

MAIL_BACKEND=smtp
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=support@jahbyte.com
SMTP_PASSWORD=replace-with-smtp-password
MAIL_FROM=support@jahbyte.com
WEB_APP_URL=https://slowmo.co

SEED_FOUNDER_EMAIL=williams@jahbyte.com
SEED_FOUNDER_PASSWORD=replace-with-founder-password

API_PORT=5012
SLOWMO_API_IMAGE=ghcr.io/OWNER/slowmo-api:latest
GHCR_USERNAME=
GHCR_TOKEN=
DEPLOY_BUILD_LOCAL=0
