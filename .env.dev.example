APP_ENV=dev
APP_DEBUG=true
APP_SECRET_KEY=dev-secret-change-me
# Native: sqlite:///./slowmo.dev.db
# Docker compose overrides to sqlite:////app/data/slowmo.dev.db
DATABASE_URL=sqlite:///./slowmo.dev.db
CORS_ORIGINS=http://localhost:5011,http://127.0.0.1:5011
TRUSTED_HOSTS=localhost,127.0.0.1
JWT_ACCESS_SECRET=dev-access-secret
JWT_REFRESH_SECRET=dev-refresh-secret
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=14
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_test_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=whsec_dev_placeholder
RAZORPAY_WEBHOOK_URL=http://localhost:5012/api/v1/webhooks/razorpay
SHIPPING_PROVIDER=stub

# Backblaze B2 (S3-compatible). Use local only for offline/unit tests.
STORAGE_BACKEND=b2
STORAGE_DIR=./storage/rx
B2_ENDPOINT=s3.us-east-005.backblazeb2.com
B2_BUCKET_ID=replace-with-bucket-id
B2_BUCKET_NAME=replace-with-bucket-name
B2_APPLICATION_KEY_ID=replace-with-key-id
B2_APPLICATION_KEY=replace-with-application-key
B2_BUCKET_REGION=us-east-005
# Optional friendly/public base URL for file links. If empty, uses endpoint/bucket/key.
B2_PUBLIC_FILE_BASE_URL=

MAIL_BACKEND=console
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=support@jahbyte.com
SMTP_PASSWORD=
MAIL_FROM=support@jahbyte.com
WEB_APP_URL=http://localhost:5011
SEED_FOUNDER_EMAIL=williams@jahbyte.com
SEED_FOUNDER_PASSWORD=FounderDev123!
API_PORT=5012
